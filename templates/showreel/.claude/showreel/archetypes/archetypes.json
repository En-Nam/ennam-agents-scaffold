{
  "version": 1,
  "archetypes": {
    "cold-open-command": {
      "role": "open",
      "variants": ["terminal"],
      "minWeight": 0.75,
      "slots": {
        "command": { "source": "fact", "kinds": ["command"], "min": 1, "max": 1, "maxChars": 64 },
        "caption": { "source": "phrase", "tags": ["open"], "min": 0, "max": 1 }
      },
      "typing": "command",
      "defaultCues": [{ "name": "enter", "at": 0.72, "kind": "boom", "amp": 1.0 }]
    },
    "kinetic-text": {
      "role": "body",
      "variants": ["stack", "punch", "chapter"],
      "minWeight": 0.5,
      "slots": {
        "lines": { "source": "fact", "kinds": ["feature", "app.tagline", "stack.item", "problem"], "min": 1, "max": 3, "maxChars": 48 },
        "lead": { "source": "phrase", "tags": ["lead"], "min": 0, "max": 1 }
      },
      "variantSlots": {
        "chapter": {
          "lines": { "min": 0, "max": 1 },
          "lead": { "tags": ["chapter"], "min": 1, "max": 1 }
        }
      },
      "defaultCues": [{ "name": "line", "at": 0.15, "kind": "snap", "amp": 0.3 }]
    },
    "metrics-counter-lock": {
      "role": "body",
      "variants": ["row", "grid"],
      "minWeight": 0.75,
      "slots": {
        "counters": { "source": "fact", "kinds": ["count"], "min": 1, "max": 4, "maxChars": 12 },
        "label": { "source": "phrase", "tags": ["metrics"], "min": 0, "max": 1 }
      },
      "defaultCues": [{ "name": "lock", "at": 0.6, "kind": "lock", "amp": 0.4 }]
    },
    "lockup-cta": {
      "role": "close",
      "variants": ["center"],
      "minWeight": 1.0,
      "slots": {
        "name": { "source": "fact", "kinds": ["app.name"], "min": 1, "max": 1, "maxChars": 32 },
        "tagline": { "source": "fact", "kinds": ["app.tagline"], "min": 0, "max": 1, "maxChars": 64 },
        "command": { "source": "fact", "kinds": ["command"], "min": 0, "max": 1, "maxChars": 64 },
        "cta": { "source": "phrase", "tags": ["cta"], "min": 0, "max": 1 }
      },
      "defaultCues": [
        { "name": "slam", "at": 0.12, "kind": "slam", "amp": 1.0 },
        { "name": "sweep", "at": 0.6, "kind": "sweep", "amp": 0.35 }
      ]
    },
    "flow-graph": {
      "role": "body",
      "variants": ["converge", "chain", "cluster"],
      "minWeight": 1.0,
      "slots": {
        "steps": { "source": "fact", "kinds": ["route", "command", "feature", "stack.item"], "min": 3, "max": 6, "maxChars": 28 },
        "lead": { "source": "phrase", "tags": ["flow"], "min": 0, "max": 1 }
      },
      "variantSlots": {
        "converge": { "steps": { "sequence": true } },
        "chain": { "steps": { "sequence": true } }
      },
      "cueMaps": [{ "name": "step", "per": "steps", "kind": "snap", "amp": 0.3, "from": 0.15, "to": 0.5 }],
      "defaultCues": [{ "name": "converge", "at": 0.85, "kind": "sweep", "amp": 0.6 }]
    },
    "layered-stack": {
      "role": "body",
      "variants": ["slabs"],
      "minWeight": 1.0,
      "slots": {
        "layers": { "source": "fact", "kinds": ["stack.item", "feature"], "min": 2, "max": 5, "maxChars": 24 },
        "label": { "source": "phrase", "tags": ["stack"], "min": 0, "max": 1 }
      },
      "cueMaps": [{ "name": "layer", "per": "layers", "kind": "thud", "amp": 0.5, "from": 0.15, "to": 0.65 }]
    },
    "card-carousel": {
      "role": "body",
      "variants": ["row", "fan"],
      "minWeight": 1.0,
      "slots": {
        "cards": { "source": "fact", "kinds": ["feature", "route", "command"], "min": 3, "max": 6, "maxChars": 32 },
        "lead": { "source": "phrase", "tags": ["carousel"], "min": 0, "max": 1 }
      },
      "cueMaps": [{ "name": "card", "per": "cards", "kind": "snap", "amp": 0.25, "from": 0.2, "to": 0.7 }],
      "defaultCues": [{ "name": "settle", "at": 0.8, "kind": "sweep", "amp": 0.35 }]
    },
    "orbit-network": {
      "role": "body",
      "variants": ["orbit"],
      "minWeight": 1.25,
      "slots": {
        "hub": { "source": "fact", "kinds": ["app.name"], "min": 1, "max": 1, "maxChars": 24 },
        "nodes": { "source": "fact", "kinds": ["stack.item", "feature", "route"], "min": 3, "max": 8, "maxChars": 20 }
      },
      "cueMaps": [{ "name": "node", "per": "nodes", "kind": "pop", "amp": 0.15, "from": 0.2, "to": 0.45 }],
      "defaultCues": [{ "name": "ignite", "at": 0.12, "kind": "ignite", "amp": 0.8 }]
    }
  }
}
